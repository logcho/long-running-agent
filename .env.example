# LLM Provider Configuration ('ollama' or 'openai')
LLM_PROVIDER=ollama

# Ollama Configurations
OLLAMA_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configurations (Required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Agent Limits
MAX_ITERATIONS=30
CONTEXT_WINDOW_LIMIT=8
